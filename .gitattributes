# Static build manifests hash exact bytes; keep text assets consistent across platforms.
prototypes/desktop/*.html text eol=lf
prototypes/desktop/*.css text eol=lf
prototypes/desktop/*.js text eol=lf
prototypes/desktop/video-config.json text eol=lf
prototypes/desktop/locales/*.json text eol=lf
prototypes/desktop/locales/*.js text eol=lf
prototypes/desktop/assets/**/*.svg text eol=lf
# Research patches record exact byte counts and SHA-256 values.
docs/research/evidence/*.patch text eol=lf
# This new metadata report has a recorded SHA-256 over its exact JSON bytes.
docs/research/evidence/manual-worker-metadata-s2.json text eol=lf
docs/research/evidence/manual-worker-live-reservation-blocked.json text eol=lf
docs/research/evidence/manual-worker-live-protocol-blocked.json text eol=lf
docs/research/evidence/manual-worker-live-protocol-inspection.json text eol=lf
docs/research/evidence/manual-worker-live-protocol-rollout-facts.json text eol=lf
docs/research/evidence/manual-worker-live-remote-status-blocked.json text eol=lf
docs/research/evidence/manual-worker-live-remote-status-inspection.json text eol=lf
docs/research/evidence/manual-worker-live-success.json text eol=lf
docs/research/evidence/manual-worker-live-success-inspection.json text eol=lf
# Preserve the read-only inspection's original CRLF bytes and check real whitespace.
docs/research/evidence/manual-worker-live-reservation-inspection.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Portable Core sources and generated conformance bytes must survive Windows checkout.
Cargo.toml text eol=lf
Cargo.lock text eol=lf
crates/**/*.toml text eol=lf
crates/**/*.rs text eol=lf
crates/**/tests/fixtures/*.json text eol=lf
tools/runtime-harness/fixtures/portable-input-v1.json text eol=lf
